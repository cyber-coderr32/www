# Arquivo de exemplo para variáveis de ambiente (functions/.env, fora do git)
# REGRA INEGOCIÁVEL DE SEGURANÇA: O client_secret da Cakto e o secret do webhook NUNCA podem aparecer em código no navegador.
CAKTO_API_CLIENT_ID=seu_client_id_aqui
CAKTO_API_CLIENT_SECRET=sua_secret_key_aqui
CAKTO_PRODUCT_ID=id_do_produto_aqui
CAKTO_WEBHOOK_SECRET=secret_do_webhook_gerado_no_passo_4
